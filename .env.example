# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/workbench?sslmode=require

# NextAuth — set to your canonical domain in production
NEXTAUTH_URL=https://wisepsy.cn
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Email (magic link + stage notifications)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=noreply@wisepsy.cn
EMAIL_SERVER_PASSWORD=replace-me
EMAIL_FROM=noreply@wisepsy.cn

# Portal base URL (for magic-link emails to clients)
PORTAL_BASE_URL=https://wisepsy.cn

# Server Actions allowed origins (comma-separated, no protocol)
# Production: wisepsy.cn,www.wisepsy.cn
# Development: localhost:3000
ALLOWED_ORIGINS=wisepsy.cn,www.wisepsy.cn
